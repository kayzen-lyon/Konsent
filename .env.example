# Konsent — variables d'environnement.
#
# Aucune de ces valeurs n'est dans le dépôt, et aucune ne doit y entrer.
# Les clés se posent dans Vercel : Settings > Environment Variables.

# --- Stripe ---------------------------------------------------------------
# Clé SECRÈTE. Ne jamais la committer, ne jamais la coller dans un ticket.
# Test : sk_test_… · Production : sk_live_…
STRIPE_SECRET_KEY=

# Secret de signature du webhook, fourni par Stripe à la création du point de
# terminaison. Sans lui, la route /api/billing/webhook refuse tout événement —
# c'est voulu : sans signature, n'importe qui pourrait déclarer un paiement.
STRIPE_WEBHOOK_SECRET=

# Identifiants de TARIF (price_…). Ce ne sont pas des secrets : ils circulent
# côté navigateur. Ils diffèrent entre test et production, d'où leur présence
# ici plutôt qu'en dur dans le code.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCE=

# --- Base de données (Neon Postgres, Francfort) ---------------------------
# Posée automatiquement par l'intégration Neon du Marketplace Vercel
# (`vercel env pull .env.local`). Sans elle, l'application fonctionne à
# l'identique : comptes, surveillance et clés d'API sont simplement inactifs.
# Schéma : db/schema.sql, appliqué par `node --env-file=.env.local scripts/db-schema.mjs`.
DATABASE_URL=
CRON_SECRET=

# --- Archive de preuve ----------------------------------------------------
# Clé Ed25519 PKCS#8 PEM encodée en base64. Sans elle, une clé éphémère est
# générée et le manifeste indique que l'archive n'a aucune valeur d'opposabilité.
KONSENT_SIGNING_KEY=

# --- Worker navigateur (protocole en trois phases) ------------------------
# Sans ces deux variables, /api/scan et /scan servent le moteur STATIQUE :
# 48 règles sur 139 au lieu de 70 au plus, et le rapport l'écrit en clair.
# C'est le jalon P0 du PRD qui se joue ici — voir worker/README.md.
#
# URL de base du service worker, sans chemin. Exemple : https://worker.konsent.fr
KONSENT_WORKER_URL=

# Jeton partagé entre l'application et le worker. Le worker refuse toute
# analyse s'il n'en a pas : un worker ouvert serait un scanner gratuit pour
# n'importe qui, sous NOTRE user-agent et donc sous notre responsabilité.
# Générer avec : openssl rand -base64 32
KONSENT_WORKER_SECRET=

# Budget d'attente de l'application, en millisecondes (défaut : 45000).
# À garder inférieur au maxDuration des routes concernées (60 s).
KONSENT_WORKER_TIMEOUT_MS=

# --- Envoi d'e-mails ------------------------------------------------------
# Sans ces deux variables, les alertes de surveillance ne partent pas et les
# liens de connexion ne sont pas délivrés. L'application fonctionne, mais ces
# deux promesses ne sont pas tenues — et /tarifs le signale.
RESEND_API_KEY=
KONSENT_MAIL_FROM="Konsent <alertes@konsent.fr>"

# --- Sécurité -------------------------------------------------------------
# Origine canonique du site. Les liens de connexion et les URL de retour
# Stripe sont construits depuis elle, JAMAIS depuis l'en-tête Host (un Host
# forgé enverrait le jeton de connexion chez un tiers). Facultatif en
# production (défaut : https://konsent.kayzen-lyon.com) ; utile en préversion.
KONSENT_SITE_URL=

# Secret qui lie un lien de connexion au navigateur qui l'a demandé (contre
# le « login CSRF »). À défaut, la clé service_role Supabase est utilisée.
# Générer avec : openssl rand -base64 32
KONSENT_AUTH_SECRET=

# Secret de signature du jeton anti-robot du formulaire de contact. Sans lui,
# une valeur fixe est utilisée et le jeton devient falsifiable.
KONSENT_FORM_SECRET=
