# Konsent — variables d'environnement.
#
# Aucune de ces valeurs n'est dans le dépôt, et aucune ne doit y entrer.
# Les clés se posent dans Vercel : Settings > Environment Variables.

# --- Stripe ---------------------------------------------------------------
# Clé SECRÈTE. Ne jamais la committer, ne jamais la coller dans un ticket.
# Test : sk_test_… · Production : sk_live_…
STRIPE_SECRET_KEY=

# Secret de signature du webhook, fourni par Stripe à la création du point de
# terminaison. Sans lui, la route /api/billing/webhook refuse tout événement —
# c'est voulu : sans signature, n'importe qui pourrait déclarer un paiement.
STRIPE_WEBHOOK_SECRET=

# Identifiants de TARIF (price_…). Ce ne sont pas des secrets : ils circulent
# côté navigateur. Ils diffèrent entre test et production, d'où leur présence
# ici plutôt qu'en dur dans le code.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCE=

# --- Supabase (surveillance planifiée, facultatif) ------------------------
# Sans ces variables, l'application fonctionne à l'identique : la conservation
# opt-in et le cron de surveillance sont simplement inactifs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# --- Archive de preuve ----------------------------------------------------
# Clé Ed25519 PKCS#8 PEM encodée en base64. Sans elle, une clé éphémère est
# générée et le manifeste indique que l'archive n'a aucune valeur d'opposabilité.
KONSENT_SIGNING_KEY=

# --- Envoi d'e-mails ------------------------------------------------------
# Sans ces deux variables, les alertes de surveillance ne partent pas et les
# liens de connexion ne sont pas délivrés. L'application fonctionne, mais ces
# deux promesses ne sont pas tenues — et /tarifs le signale.
RESEND_API_KEY=
KONSENT_MAIL_FROM="Konsent <alertes@konsent.fr>"
