{
  "name": "konsent-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Worker d'analyse en navigateur — protocole en trois phases (avant consentement / après refus / après acceptation).",
  "scripts": {
    "scan": "node --experimental-strip-types src/index.ts",
    "serve": "node --experimental-strip-types src/server.ts",
    "build:vercel": "node scripts/build-vercel.mjs",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.65.1",
    "playwright-core": "1.65.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@sparticuz/chromium": "152.0.0",
    "esbuild": "0.28.2"
  }
}
